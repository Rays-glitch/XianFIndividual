{{> head }}
<body>
  <div class="page-shell">
    {{> sidebar }}
    <main class="main-panel">
      {{> header }}

      <section class="panel page-panel">
        <div class="panel-header split-row">
          <div>
            <h3>Customer Records</h3>
            <p class="muted-text">Showing {{totalCustomers}} results</p>
          </div>
          <div class="header-actions">
            <a class="primary-btn" href="/customers/add">Add New Customer</a>
          </div>
        </div>

        <form class="filter-bar" method="GET" action="/customers">
          <input type="text" name="search" value="{{search}}" placeholder="Search by name, code, email, or phone" />
          <select name="customerType">
            <option value="">All customer types</option>
            <option value="Regular" {{#if (eq customerType "Regular")}}selected{{/if}}>Regular</option>
            <option value="VIP" {{#if (eq customerType "VIP")}}selected{{/if}}>VIP</option>
          </select>
          <select name="status">
            <option value="">All statuses</option>
            <option value="Active" {{#if (eq status "Active")}}selected{{/if}}>Active</option>
            <option value="Inactive" {{#if (eq status "Inactive")}}selected{{/if}}>Inactive</option>
          </select>
          <button class="secondary-btn" type="submit">Apply</button>
        </form>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Customer ID</th>
                <th>Customer Code</th>
                <th>Customer Name</th>
                <th>Email Address</th>
                <th>Contact Number</th>
                <th>Customer Type</th>
                <th>Registration Date</th>
                <th>Account Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#if customers.length}}
                {{#each customers}}
                  <tr>
                    <td>{{this.id}}</td>
                    <td>{{this.customer_code}}</td>
                    <td>{{this.first_name}} {{this.last_name}}</td>
                    <td>{{this.email}}</td>
                    <td>{{this.phone}}</td>
                    <td><span class="badge badge-type {{#if (eq this.customer_type "VIP")}}badge-vip{{else}}badge-regular{{/if}}">{{this.customer_type}}</span></td>
                    <td>{{formatDate this.createdAt}}</td>
                    <td><span class="badge badge-status {{#if (eq this.status "Active")}}badge-active{{else}}badge-inactive{{/if}}">{{this.status}}</span></td>
                    <td class="action-cell">
                      <a class="table-link" href="/customers/{{this.id}}">View</a>
                      <a class="table-link" href="/customers/{{this.id}}/edit">Edit</a>
                      <form method="POST" action="/customers/{{this.id}}/status" class="inline-form" data-confirm="{{#if (eq this.status "Active")}}Deactivate{{else}}Reactivate{{/if}} customer">
                        <input type="hidden" name="status" value="{{#if (eq this.status "Active")}}Inactive{{else}}Active{{/if}}" />
                        <button type="submit" class="text-button">
                          {{#if (eq this.status "Active")}}Deactivate{{else}}Reactivate{{/if}}
                        </button>
                      </form>
                    </td>
                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="9" class="empty-state">No customers found for the selected filter.</td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>

        <div class="pagination-row">
          <span>Page {{page}} of {{pages}}</span>
          <div class="pagination-actions">
            {{#if (gt page 1)}}
              <a href="/customers?page={{minus page 1}}&search={{search}}&customerType={{customerType}}&status={{status}}" class="secondary-btn">Previous</a>
            {{/if}}
            {{#if (lt page pages)}}
              <a href="/customers?page={{plus page 1}}&search={{search}}&customerType={{customerType}}&status={{status}}" class="secondary-btn">Next</a>
            {{/if}}
          </div>
        </div>
      </section>
    </main>
  </div>
  <script src="/js/customer.js"></script>
</body>
{{> footer }}
